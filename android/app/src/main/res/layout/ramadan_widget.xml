<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ramadan_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_ramadan_bg"
    android:padding="12dp">

    <!-- Header Row: Ramadan Title + Location/Hijri on Left, Dynamic Phase Badge on Right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/ramadan_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ramazon · Ro‘za"
                android:textColor="#FBBF24"
                android:textSize="12sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/ramadan_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tashkent"
                android:textColor="#E2E8F0"
                android:textSize="10.5sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/ramadan_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_ramadan_badge"
            android:paddingLeft="9dp"
            android:paddingRight="9dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="Iftorgacha ro‘za"
            android:textColor="#FDE68A"
            android:textSize="10sp"
            android:textStyle="bold"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Focus Cards: Saharlik (Imsak) & Iftorlik (Maghrib) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="7dp">

        <LinearLayout
            android:id="@+id/ramadan_card_suhoor"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_ramadan_card"
            android:padding="6dp"
            android:layout_marginEnd="6dp">

            <TextView
                android:id="@+id/ramadan_suhoor_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saharlik"
                android:textColor="#CBD5E1"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/ramadan_suhoor_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ramadan_card_iftor"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_ramadan_card_active"
            android:padding="6dp">

            <TextView
                android:id="@+id/ramadan_iftor_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Iftorlik"
                android:textColor="#FDE68A"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/ramadan_iftor_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="#FBBF24"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="1dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Quick Times: Fajr, Sunrise, Asr, Isha -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/widget_info_bar_bg"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:paddingLeft="6dp"
        android:paddingRight="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/ramadan_fajr_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bomdod"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:singleLine="true" />
            <TextView
                android:id="@+id/ramadan_fajr_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/ramadan_sunrise_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quyosh"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:singleLine="true" />
            <TextView
                android:id="@+id/ramadan_sunrise_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/ramadan_asr_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Asr"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:singleLine="true" />
            <TextView
                android:id="@+id/ramadan_asr_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/ramadan_isha_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xufton"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:singleLine="true" />
            <TextView
                android:id="@+id/ramadan_isha_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
