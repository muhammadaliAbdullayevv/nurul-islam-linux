<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/strip_widget_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:background="@drawable/widget_strip_bg"
        android:padding="0dp">

        <!-- Top Header Bar: City on Left, Date on Right (24dp tall) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_strip_header_bg"
            android:paddingLeft="10dp"
            android:paddingRight="10dp">

            <TextView
                android:id="@+id/strip_city"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Toshkent"
                android:textColor="#FDE68A"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/strip_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#D0F39F"
                android:textSize="11sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Horizontal Gold Hairline Divider under Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#59E2B449" />

        <!-- Bottom 6 Columns Row: Tight 46dp height so there is zero wasted top/bottom space -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 1. Bomdod (Leftmost cell) -->
            <LinearLayout
                android:id="@+id/strip_cell_fajr"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingLeft="1dp"
                android:paddingRight="1dp">
                <TextView
                    android:id="@+id/strip_label_fajr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bomdod"
                    android:textColor="#E2F8D5"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:singleLine="true" />
                <TextView
                    android:id="@+id/strip_time_fajr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--:--"
                    android:textColor="#FFFFFF"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#47E2B449" />

            <!-- 2. Quyosh (Sunrise cell) -->
            <LinearLayout
                android:id="@+id/strip_cell_sunrise"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingLeft="1dp"
                android:paddingRight="1dp">
                <TextView
                    android:id="@+id/strip_label_sunrise"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quyosh"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:singleLine="true" />
                <TextView
                    android:id="@+id/strip_time_sunrise"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--:--"
                    android:textColor="#FFFFFF"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#47E2B449" />

            <!-- 3. Peshin -->
            <LinearLayout
                android:id="@+id/strip_cell_dhuhr"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingLeft="1dp"
                android:paddingRight="1dp">
                <TextView
                    android:id="@+id/strip_label_dhuhr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Peshin"
                    android:textColor="#E2F8D5"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:singleLine="true" />
                <TextView
                    android:id="@+id/strip_time_dhuhr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--:--"
                    android:textColor="#FFFFFF"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#47E2B449" />

            <!-- 4. Asr -->
            <LinearLayout
                android:id="@+id/strip_cell_asr"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingLeft="1dp"
                android:paddingRight="1dp">
                <TextView
                    android:id="@+id/strip_label_asr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Asr"
                    android:textColor="#E2F8D5"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:singleLine="true" />
                <TextView
                    android:id="@+id/strip_time_asr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--:--"
                    android:textColor="#FFFFFF"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#47E2B449" />

            <!-- 5. Shom -->
            <LinearLayout
                android:id="@+id/strip_cell_maghrib"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingLeft="1dp"
                android:paddingRight="1dp">
                <TextView
                    android:id="@+id/strip_label_maghrib"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shom"
                    android:textColor="#E2F8D5"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:singleLine="true" />
                <TextView
                    android:id="@+id/strip_time_maghrib"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--:--"
                    android:textColor="#FFFFFF"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#47E2B449" />

            <!-- 6. Xufton (Rightmost cell) -->
            <LinearLayout
                android:id="@+id/strip_cell_isha"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingLeft="1dp"
                android:paddingRight="1dp">
                <TextView
                    android:id="@+id/strip_label_isha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xufton"
                    android:textColor="#E2F8D5"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:singleLine="true" />
                <TextView
                    android:id="@+id/strip_time_isha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--:--"
                    android:textColor="#FFFFFF"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
